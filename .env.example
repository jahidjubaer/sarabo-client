# Copy this file to .env and fill in real values. .env is gitignored and must
# never be committed. See README.md for what each variable is used for.

# Base URL of the sarabo-server API (defaults to http://localhost:3000 if unset)
VITE_API_BASE_URL=http://localhost:3000

# Firebase web app config (from your Firebase project settings)
VITE_apiKey=your_firebase_api_key
VITE_authDomain=your_project.firebaseapp.com
VITE_projectId=your_firebase_project_id
VITE_storageBucket=your_project.appspot.com
VITE_messagingSenderId=your_messaging_sender_id
VITE_appId=your_firebase_app_id
VITE_measurementId=your_measurement_id

# imgbb API key, used to upload registration/profile photos
VITE_image_host_key=your_imgbb_api_key
